{
  "name": "b2b-product-starter",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/product-map.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test:email && npm run build",
    "email:preview": "email dev --dir emails --port 3001",
    "email:smoke": "node --import tsx scripts/email-smoke.ts",
    "test:email": "node --import tsx --test features/email/email.test.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.59.0",
    "motion": "14.14.0",
    "next": "16.4.5",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "6.11.14",
    "recharts": "^3.8.0",
    "resend": "6.38.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@react-email/ui": "6.11.14",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@react-email/ui": {
      "next": "$next"
    }
  }
}
