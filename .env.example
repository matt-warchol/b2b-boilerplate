# Copy to .env.local. Keep these variables on the server.
EMAIL_MODE=dry-run
EMAIL_APP_ORIGIN=http://localhost:3000
# A verified sender such as Your product <hello@notify.example.com>.
EMAIL_FROM=
# A monitored inbox if replies should go somewhere other than EMAIL_FROM.
EMAIL_REPLY_TO=
# A Resend sending key for the verified domain.
RESEND_API_KEY=

# Feedback agent (server-only values; never prefix with NEXT_PUBLIC_)
FEEDBACK_LLM_PROVIDER=anthropic       # anthropic | openai | openai-compatible
FEEDBACK_LLM_API_KEY=
FEEDBACK_LLM_MODEL=                   # empty = cheap default (claude-haiku-5-5 / gpt-4o-mini)
FEEDBACK_LLM_BASE_URL=                # only for openai-compatible
FEEDBACK_DAILY_BUDGET_USD=2           # hard daily cap across all users
FEEDBACK_PRICE_IN_USD_PER_MTOK=1      # your model's real prices, used to count spend
FEEDBACK_PRICE_OUT_USD_PER_MTOK=5
FEEDBACK_ENABLED=                     # 1 = show the widget (redeploy after changing)
FEEDBACK_ALLOW_DEMO_USER=             # 1 = attribute messages to a demo user (Preview only; no sign-in in the starter)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Browser analytics + cookie banner (website and product). Off when empty.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
# RESEND_API_KEY (above) is shared with the feedback digest.
FEEDBACK_DIGEST_FROM=Feedback <feedback@example.com>
FEEDBACK_DIGEST_TO=you@example.com
CRON_SECRET=                          # 24+ chars: openssl rand -hex 32.  Vercel sends it as a Bearer token to cron routes
FEEDBACK_ADMIN_TOKEN=                 # 24+ chars: openssl rand -hex 32.  unlocks /admin/feedback
