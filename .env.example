# Feedback agent (server-only values; never prefix with NEXT_PUBLIC_)
FEEDBACK_LLM_PROVIDER=openai          # openai | anthropic | openai-compatible
FEEDBACK_LLM_API_KEY=
FEEDBACK_LLM_MODEL=                   # empty = cheap default (gpt-4o-mini / claude-haiku-5-5)
FEEDBACK_LLM_BASE_URL=                # only for openai-compatible
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
RESEND_API_KEY=
FEEDBACK_DIGEST_FROM=Feedback <feedback@example.com>
FEEDBACK_DIGEST_TO=you@example.com
CRON_SECRET=                          # Vercel sends it as a Bearer token to cron routes
FEEDBACK_ADMIN_TOKEN=                 # unlocks /admin/feedback
